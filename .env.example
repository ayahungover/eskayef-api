# Copy this file to .env and fill in your SQL Server details.

# SQL Server host (hostname or IP)
DB_SERVER=localhost

# Database name
DB_NAME=ERP

# SQL Server login (SQL authentication)
DB_USER=sa
DB_PASSWORD=YourStrongPassword123

# ODBC driver installed on your machine (check ODBC Data Sources app)
DB_DRIVER=ODBC Driver 17 for SQL Server

# Helps with encrypted connections on local/dev servers (use false in strict prod if you rely on certs)
DB_TRUST_SERVER_CERTIFICATE=true

# API settings
API_TITLE=ERP API
API_VERSION=0.1.0
DEBUG=true

# Browser origins allowed for CORS (React on Vite). Add your machine URL if needed.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
